<?xml version="1.0" encoding="utf-8"?>
<!-- Open Compendium core library: rules and lists the program needs, written for Open Compendium (no book text).
     It ships with the program and may be shared. Edit it with care: the program reads it as it is. -->
<D20Rules game-system="D&amp;D4E">
  <!-- Point buy and ability arrays (Player's Handbook, chapter 2) -->
  <RulesElement name="Point Buy" type="Core Table" internal-id="ID_OCC_POINT_BUY" source="Open Compendium Core">
    <specific name="Points">22</specific>
    <specific name="Costs">10:0, 11:1, 12:2, 13:3, 14:5, 15:7, 16:9, 17:12, 18:16</specific>
    Scores start at 10 (one may start at 8). Costs are cumulative for raising a score from 10.
  </RulesElement>
  <RulesElement name="18, 14, 11, 10, 10, 8" type="Ability Array" internal-id="ID_OCC_ARRAY_1" source="Open Compendium Core">
    <specific name="Scores">18, 14, 11, 10, 10, 8</specific>
  </RulesElement>
  <RulesElement name="18, 13, 13, 10, 10, 8" type="Ability Array" internal-id="ID_OCC_ARRAY_2" source="Open Compendium Core">
    <specific name="Scores">18, 13, 13, 10, 10, 8</specific>
  </RulesElement>
  <RulesElement name="18, 13, 11, 10, 10, 10" type="Ability Array" internal-id="ID_OCC_ARRAY_3" source="Open Compendium Core">
    <specific name="Scores">18, 13, 11, 10, 10, 10</specific>
  </RulesElement>
  <RulesElement name="17, 16, 11, 10, 10, 8" type="Ability Array" internal-id="ID_OCC_ARRAY_4" source="Open Compendium Core">
    <specific name="Scores">17, 16, 11, 10, 10, 8</specific>
  </RulesElement>
  <RulesElement name="17, 15, 13, 10, 10, 8" type="Ability Array" internal-id="ID_OCC_ARRAY_5" source="Open Compendium Core">
    <specific name="Scores">17, 15, 13, 10, 10, 8</specific>
  </RulesElement>
  <RulesElement name="17, 14, 12, 11, 10, 8" type="Ability Array" internal-id="ID_OCC_ARRAY_6" source="Open Compendium Core">
    <specific name="Scores">17, 14, 12, 11, 10, 8</specific>
  </RulesElement>
  <RulesElement name="16, 16, 13, 11, 10, 8" type="Ability Array" internal-id="ID_OCC_ARRAY_7" source="Open Compendium Core">
    <specific name="Scores">16, 16, 13, 11, 10, 8</specific>
  </RulesElement>
  <RulesElement name="16, 16, 12, 12, 11, 8" type="Ability Array" internal-id="ID_OCC_ARRAY_8" source="Open Compendium Core">
    <specific name="Scores">16, 16, 12, 12, 11, 8</specific>
  </RulesElement>
  <RulesElement name="16, 14, 14, 11, 11, 8" type="Ability Array" internal-id="ID_OCC_ARRAY_9" source="Open Compendium Core">
    <specific name="Scores">16, 14, 14, 11, 11, 8</specific>
  </RulesElement>
  <RulesElement name="16, 14, 13, 12, 11, 10" type="Ability Array" internal-id="ID_OCC_ARRAY_10" source="Open Compendium Core">
    <specific name="Scores">16, 14, 13, 12, 11, 10</specific>
    <specific name="Standard">Yes</specific>
  </RulesElement>
  <!-- Experience and money by level -->
  <RulesElement name="Experience by Level" type="Core Table" internal-id="ID_OCC_XP" source="Open Compendium Core">
    <specific name="Values">0, 1000, 2250, 3750, 5500, 7500, 10000, 13000, 16500, 20500, 26000, 32000, 39000, 47000, 57000, 69000, 83000, 99000, 119000, 143000, 175000, 210000, 255000, 310000, 375000, 450000, 550000, 675000, 825000, 1000000</specific>
    Total XP needed for levels 1 to 30. Used only when the builder library has no level table.
  </RulesElement>
  <RulesElement name="Starting Money" type="Core Table" internal-id="ID_OCC_START_MONEY" source="Open Compendium Core">
    <specific name="Gold">100</specific>
    A new 1st-level character starts with 100 gp. Above 1st level: the price of a magic item one level lower (see Magic Item Value by Level).
  </RulesElement>
  <RulesElement name="Magic Item Value by Level" type="Core Table" internal-id="ID_OCC_ITEM_VALUE" source="Open Compendium Core">
    <specific name="Values">360, 520, 680, 840, 1000, 1800, 2600, 3400, 4200, 5000, 9000, 13000, 17000, 21000, 25000, 45000, 65000, 85000, 105000, 125000, 225000, 325000, 425000, 525000, 625000, 1125000, 1625000, 2125000, 2625000, 3125000</specific>
    Price in gold of a typical magic item of levels 1 to 30, used for starting money above 1st level.
  </RulesElement>
  <!-- Monster math: older monsters with the newer numbers (the compendium switch, DM tools) -->
  <RulesElement name="Monster Damage by Level" type="Core Table" internal-id="ID_OCC_MONSTER_DAMAGE" source="Open Compendium Core">
    <specific name="Single">1d8 + 4, 1d8 + 5, 1d8 + 6, 2d6 + 5, 2d6 + 6, 2d6 + 7, 2d8 + 6, 2d8 + 7, 2d8 + 8, 2d8 + 9, 3d6 + 9, 3d6 + 10, 3d6 + 11, 3d6 + 12, 3d6 + 13, 3d8 + 11, 3d8 + 12, 3d8 + 13, 3d8 + 14, 3d8 + 15, 4d6 + 15, 4d6 + 16, 4d6 + 17, 4d6 + 18, 4d6 + 19, 4d8 + 16, 4d8 + 17, 4d8 + 18, 4d8 + 19, 4d8 + 20</specific>
    <specific name="Multiple">1d6 + 3, 1d6 + 4, 1d6 + 5, 1d8 + 5, 1d8 + 6, 1d8 + 6, 2d6 + 4, 2d6 + 5, 2d6 + 6, 2d6 + 6, 2d6 + 7, 2d8 + 6, 2d8 + 7, 2d8 + 7, 2d8 + 8, 3d6 + 8, 3d6 + 9, 3d6 + 9, 3d6 + 10, 3d6 + 11, 3d8 + 9, 3d8 + 9, 3d8 + 10, 3d8 + 11, 3d8 + 12, 4d6 + 11, 4d6 + 12, 4d6 + 13, 4d6 + 14, 4d6 + 15</specific>
    Damage for levels 1 to 30: one target, and two or more targets (Dungeon Master's Kit, page 108, the 2010 damage that the newer monsters use).
  </RulesElement>
  <RulesElement name="Original Monster Damage by Level" type="Core Table" internal-id="ID_OCC_MONSTER_DAMAGE_OLD" source="Open Compendium Core">
    <specific name="Levels">1-3, 4-6, 7-9, 10-12, 13-15, 16-18, 19-21, 22-24, 25-27, 28-30</specific>
    <specific name="Low">1d6 + 3, 1d6 + 4, 1d8 + 5, 1d8 + 5, 1d10 + 6, 1d10 + 7, 2d6 + 7, 2d6 + 8, 2d8 + 9, 2d8 + 10</specific>
    <specific name="Medium">1d10 + 3, 1d10 + 4, 2d6 + 5, 2d6 + 5, 2d8 + 6, 2d8 + 7, 3d6 + 8, 3d6 + 8, 3d8 + 9, 3d8 + 10</specific>
    <specific name="High">2d6 + 3, 2d8 + 4, 2d8 + 5, 3d6 + 5, 3d6 + 6, 3d8 + 7, 3d8 + 7, 4d6 + 8, 4d6 + 9, 4d8 + 10</specific>
    <specific name="Limited Low">3d6 + 3, 3d6 + 4, 3d8 + 5, 3d8 + 5, 3d10 + 6, 3d10 + 6, 4d8 + 7, 4d8 + 8, 4d10 + 9, 4d10 + 9</specific>
    <specific name="Limited Medium">2d10 + 3, 3d8 + 4, 3d10 + 5, 4d8 + 5, 4d8 + 6, 4d10 + 7, 4d10 + 7, 4d12 + 8, 5d10 + 9, 5d10 + 9</specific>
    <specific name="Limited High">3d8 + 3, 3d10 + 4, 4d8 + 5, 4d10 + 5, 4d10 + 6, 4d12 + 7, 4d12 + 7, 5d10 + 8, 5d12 + 9, 5d12 + 9</specific>
    The original Dungeon Master's Guide damage (page 42), used to see how far below its kind an older attack was.
  </RulesElement>
  <RulesElement name="Monster Math Rules" type="Core Table" internal-id="ID_OCC_MONSTER_MATH" source="Open Compendium Core">
    <specific name="Base AC">Skirmisher 14, Brute 12, Soldier 16, Lurker 14, Controller 14, Artillery 12</specific>
    <specific name="Base Other Defenses">12</specific>
    <specific name="Brute">1.25</specific>
    <specific name="Limited">1.25</specific>
    <specific name="Minion">0.5</specific>
    <specific name="Effect Floor">0.75</specific>
    <specific name="Elite Defenses">-2</specific>
    <specific name="Solo Hit Points Base">8</specific>
    <specific name="Solo Hit Points Per Level">8</specific>
    <specific name="Solo Hit Points Multiplier">4</specific>
    <specific name="Solo Hit Points Old Multiplier">5</specific>
    <specific name="Pre-MM2 Books">MM, DMG, H1, H2, H3, P1, P2, FRCG, FRPG, AV, MotP, Draco: Chromatic, Open Grave, PHB2, DD, Into the Shadowhaunt, Treasure of Talon Pass, Dun155, Dun156, Dun157, Dun158, Dun159, Dun160, Dun161, Dun162, Dun163, Dun164, Dun165, Dra364, Dra365, Dra366, Dra367, Dra368, Dra369, Dra370, Dra371, Dra372, Dra373, Dra374, DDN 2008-06, DDN 2008-07, DDN 2008-08, DDN 2008-09, DDN 2008-10, DDN 2008-11, DDN 2008-12, DDN 2009-01, DDN 2009-02, DDN 2009-03, DDN 2009-04</specific>
    Brutes and encounter or recharge attacks deal more (x1.25); minions deal half of one-target damage. An older attack that dealt less than its kind (usually for an effect) keeps that cut, at most Effect Floor. Elites and solos from books before Monster Manual 2 (May 2009) lose the old +2 on the defenses that have it (2 or more above the Dungeon Master's Guide value for their role: AC level + Base AC, other defenses level + Base Other Defenses), and every solo built with the old x5 hit points (Solo Hit Points Old Multiplier times Base + Per Level x level + Constitution score, or more) gets the newer x4 (Solo Hit Points Multiplier), the standard the 2012 rules update uses when it corrects older solos.
  </RulesElement>
  <!-- Basic attacks everyone has -->
  <RulesElement name="Charge" type="Power" internal-id="ID_OCC_CHARGE" source="Open Compendium Core">
    <specific name="Power Usage">At-Will</specific>
    <specific name="Action Type">Standard action</specific>
    <specific name="Attack Type">Melee (after moving)</specific>
    <specific name="Display">Basic Attack</specific>
    Standard action. Move up to your speed, at least 2 squares from where you started, to the nearest square from which you can attack the target.
Then make a melee basic attack or a bull rush with a +1 bonus to the attack roll.
The movement provokes opportunity attacks as usual. After a charge you can't take any further actions this turn, unless you spend an action point.
  </RulesElement>
  <RulesElement name="Unarmed" type="Weapon" internal-id="ID_OCC_UNARMED" source="Open Compendium Core">
    <specific name="Damage">1d4</specific>
    <specific name="Group">Unarmed</specific>
    <specific name="Weapon Category">Unarmed Melee</specific>
  </RulesElement>
  <!-- Actions in combat (Player's Handbook, chapter 9), shown on the character sheet -->
  <RulesElement name="Basic attack" type="Combat Action" internal-id="ID_OCC_ACTION_BASIC_ATTACK" source="Open Compendium Core">
    <specific name="Group">Standard actions</specific>
    a melee or ranged basic attack
  </RulesElement>
  <RulesElement name="Charge" type="Combat Action" internal-id="ID_OCC_ACTION_CHARGE" source="Open Compendium Core">
    <specific name="Group">Standard actions</specific>
    move your speed (at least 2 squares) and make a melee basic attack or bull rush, +1 to attack
  </RulesElement>
  <RulesElement name="Bull rush" type="Combat Action" internal-id="ID_OCC_ACTION_BULL_RUSH" source="Open Compendium Core">
    <specific name="Group">Standard actions</specific>
    Strength vs. Fortitude: push the target 1 square and shift into its space
  </RulesElement>
  <RulesElement name="Grab" type="Combat Action" internal-id="ID_OCC_ACTION_GRAB" source="Open Compendium Core">
    <specific name="Group">Standard actions</specific>
    Strength vs. Reflex: the target is immobilized until it escapes
  </RulesElement>
  <RulesElement name="Second wind" type="Combat Action" internal-id="ID_OCC_ACTION_SECOND_WIND" source="Open Compendium Core">
    <specific name="Group">Standard actions</specific>
    spend a healing surge, +2 to all defenses until the start of your next turn (once per encounter)
  </RulesElement>
  <RulesElement name="Total defense" type="Combat Action" internal-id="ID_OCC_ACTION_TOTAL_DEFENSE" source="Open Compendium Core">
    <specific name="Group">Standard actions</specific>
    +2 to all defenses until the start of your next turn
  </RulesElement>
  <RulesElement name="Aid another" type="Combat Action" internal-id="ID_OCC_ACTION_AID_ANOTHER" source="Open Compendium Core">
    <specific name="Group">Standard actions</specific>
    DC 10 check: an ally gets +2 to an attack roll or a skill check, or +2 to a defense against one attack
  </RulesElement>
  <RulesElement name="Coup de grace" type="Combat Action" internal-id="ID_OCC_ACTION_COUP_DE_GRACE" source="Open Compendium Core">
    <specific name="Group">Standard actions</specific>
    attack a helpless adjacent enemy; a hit is a critical hit
  </RulesElement>
  <RulesElement name="Ready an action" type="Combat Action" internal-id="ID_OCC_ACTION_READY_AN_ACTION" source="Open Compendium Core">
    <specific name="Group">Standard actions</specific>
    choose an action and a trigger; take it as an immediate reaction
  </RulesElement>
  <RulesElement name="Administer a potion" type="Combat Action" internal-id="ID_OCC_ACTION_ADMINISTER_A_POTION" source="Open Compendium Core">
    <specific name="Group">Standard actions</specific>
    help an unconscious ally drink a potion
  </RulesElement>
  <RulesElement name="Walk" type="Combat Action" internal-id="ID_OCC_ACTION_WALK" source="Open Compendium Core">
    <specific name="Group">Move actions</specific>
    move up to your speed
  </RulesElement>
  <RulesElement name="Shift" type="Combat Action" internal-id="ID_OCC_ACTION_SHIFT" source="Open Compendium Core">
    <specific name="Group">Move actions</specific>
    move 1 square without provoking opportunity attacks
  </RulesElement>
  <RulesElement name="Run" type="Combat Action" internal-id="ID_OCC_ACTION_RUN" source="Open Compendium Core">
    <specific name="Group">Move actions</specific>
    speed + 2; −5 to attacks and you grant combat advantage until your next turn
  </RulesElement>
  <RulesElement name="Stand up" type="Combat Action" internal-id="ID_OCC_ACTION_STAND_UP" source="Open Compendium Core">
    <specific name="Group">Move actions</specific>
    stand up from prone
  </RulesElement>
  <RulesElement name="Crawl" type="Combat Action" internal-id="ID_OCC_ACTION_CRAWL" source="Open Compendium Core">
    <specific name="Group">Move actions</specific>
    move half your speed while prone
  </RulesElement>
  <RulesElement name="Squeeze" type="Combat Action" internal-id="ID_OCC_ACTION_SQUEEZE" source="Open Compendium Core">
    <specific name="Group">Move actions</specific>
    move half your speed through a narrow space; −5 to attacks, grant combat advantage
  </RulesElement>
  <RulesElement name="Escape" type="Combat Action" internal-id="ID_OCC_ACTION_ESCAPE" source="Open Compendium Core">
    <specific name="Group">Move actions</specific>
    Acrobatics vs. Reflex or Athletics vs. Fortitude to end a grab; shift 1 square on a success
  </RulesElement>
  <RulesElement name="Draw or sheathe a weapon" type="Combat Action" internal-id="ID_OCC_ACTION_DRAW_OR_SHEATHE_A_WEAPON" source="Open Compendium Core">
    <specific name="Group">Minor actions</specific>
  </RulesElement>
  <RulesElement name="Drink a potion" type="Combat Action" internal-id="ID_OCC_ACTION_DRINK_A_POTION" source="Open Compendium Core">
    <specific name="Group">Minor actions</specific>
  </RulesElement>
  <RulesElement name="Pick up an item" type="Combat Action" internal-id="ID_OCC_ACTION_PICK_UP_AN_ITEM" source="Open Compendium Core">
    <specific name="Group">Minor actions</specific>
  </RulesElement>
  <RulesElement name="Retrieve or stow an item" type="Combat Action" internal-id="ID_OCC_ACTION_RETRIEVE_OR_STOW_AN_ITEM" source="Open Compendium Core">
    <specific name="Group">Minor actions</specific>
  </RulesElement>
  <RulesElement name="Open or close a door" type="Combat Action" internal-id="ID_OCC_ACTION_OPEN_OR_CLOSE_A_DOOR" source="Open Compendium Core">
    <specific name="Group">Minor actions</specific>
  </RulesElement>
  <RulesElement name="Drop prone" type="Combat Action" internal-id="ID_OCC_ACTION_DROP_PRONE" source="Open Compendium Core">
    <specific name="Group">Minor actions</specific>
  </RulesElement>
  <RulesElement name="Load a crossbow" type="Combat Action" internal-id="ID_OCC_ACTION_LOAD_A_CROSSBOW" source="Open Compendium Core">
    <specific name="Group">Minor actions</specific>
  </RulesElement>
  <RulesElement name="Sustain a power" type="Combat Action" internal-id="ID_OCC_ACTION_SUSTAIN_A_POWER" source="Open Compendium Core">
    <specific name="Group">Minor actions</specific>
    powers with “Sustain Minor”
  </RulesElement>
  <RulesElement name="Spend an action point" type="Combat Action" internal-id="ID_OCC_ACTION_SPEND_AN_ACTION_POINT" source="Open Compendium Core">
    <specific name="Group">Free actions</specific>
    an extra action this turn (once per encounter, not in a surprise round)
  </RulesElement>
  <RulesElement name="Talk" type="Combat Action" internal-id="ID_OCC_ACTION_TALK" source="Open Compendium Core">
    <specific name="Group">Free actions</specific>
    a few sentences
  </RulesElement>
  <RulesElement name="Drop an item" type="Combat Action" internal-id="ID_OCC_ACTION_DROP_AN_ITEM" source="Open Compendium Core">
    <specific name="Group">Free actions</specific>
  </RulesElement>
  <RulesElement name="End a grab" type="Combat Action" internal-id="ID_OCC_ACTION_END_A_GRAB" source="Open Compendium Core">
    <specific name="Group">Free actions</specific>
  </RulesElement>
  <RulesElement name="Opportunity attack" type="Combat Action" internal-id="ID_OCC_ACTION_OPPORTUNITY_ATTACK" source="Open Compendium Core">
    <specific name="Group">Immediate and opportunity actions</specific>
    a melee basic attack when an adjacent enemy moves away or makes a ranged or area attack (one per enemy turn)
  </RulesElement>
  <RulesElement name="Readied action" type="Combat Action" internal-id="ID_OCC_ACTION_READIED_ACTION" source="Open Compendium Core">
    <specific name="Group">Immediate and opportunity actions</specific>
    the action you readied, when its trigger happens
  </RulesElement>
  <RulesElement name="Immediate interrupt or reaction" type="Combat Action" internal-id="ID_OCC_ACTION_IMMEDIATE_INTERRUPT_OR_REACTION" source="Open Compendium Core">
    <specific name="Group">Immediate and opportunity actions</specific>
    a power with that action type (one per round)
  </RulesElement>
  <!-- Conditions and how long effects last, for the character sheet -->
  <RulesElement name="Blinded" type="Condition" internal-id="ID_OCC_CONDITION_BLINDED" source="Open Compendium Core">
  </RulesElement>
  <RulesElement name="Dazed" type="Condition" internal-id="ID_OCC_CONDITION_DAZED" source="Open Compendium Core">
  </RulesElement>
  <RulesElement name="Deafened" type="Condition" internal-id="ID_OCC_CONDITION_DEAFENED" source="Open Compendium Core">
  </RulesElement>
  <RulesElement name="Dominated" type="Condition" internal-id="ID_OCC_CONDITION_DOMINATED" source="Open Compendium Core">
  </RulesElement>
  <RulesElement name="Dying" type="Condition" internal-id="ID_OCC_CONDITION_DYING" source="Open Compendium Core">
  </RulesElement>
  <RulesElement name="Grabbed" type="Condition" internal-id="ID_OCC_CONDITION_GRABBED" source="Open Compendium Core">
  </RulesElement>
  <RulesElement name="Helpless" type="Condition" internal-id="ID_OCC_CONDITION_HELPLESS" source="Open Compendium Core">
  </RulesElement>
  <RulesElement name="Immobilized" type="Condition" internal-id="ID_OCC_CONDITION_IMMOBILIZED" source="Open Compendium Core">
  </RulesElement>
  <RulesElement name="Insubstantial" type="Condition" internal-id="ID_OCC_CONDITION_INSUBSTANTIAL" source="Open Compendium Core">
  </RulesElement>
  <RulesElement name="Invisible" type="Condition" internal-id="ID_OCC_CONDITION_INVISIBLE" source="Open Compendium Core">
  </RulesElement>
  <RulesElement name="Marked" type="Condition" internal-id="ID_OCC_CONDITION_MARKED" source="Open Compendium Core">
  </RulesElement>
  <RulesElement name="Petrified" type="Condition" internal-id="ID_OCC_CONDITION_PETRIFIED" source="Open Compendium Core">
  </RulesElement>
  <RulesElement name="Prone" type="Condition" internal-id="ID_OCC_CONDITION_PRONE" source="Open Compendium Core">
  </RulesElement>
  <RulesElement name="Restrained" type="Condition" internal-id="ID_OCC_CONDITION_RESTRAINED" source="Open Compendium Core">
  </RulesElement>
  <RulesElement name="Slowed" type="Condition" internal-id="ID_OCC_CONDITION_SLOWED" source="Open Compendium Core">
  </RulesElement>
  <RulesElement name="Stunned" type="Condition" internal-id="ID_OCC_CONDITION_STUNNED" source="Open Compendium Core">
  </RulesElement>
  <RulesElement name="Surprised" type="Condition" internal-id="ID_OCC_CONDITION_SURPRISED" source="Open Compendium Core">
  </RulesElement>
  <RulesElement name="Unconscious" type="Condition" internal-id="ID_OCC_CONDITION_UNCONSCIOUS" source="Open Compendium Core">
  </RulesElement>
  <RulesElement name="Weakened" type="Condition" internal-id="ID_OCC_CONDITION_WEAKENED" source="Open Compendium Core">
  </RulesElement>
  <RulesElement name="Ongoing damage" type="Condition" internal-id="ID_OCC_CONDITION_ONGOING_DAMAGE" source="Open Compendium Core">
  </RulesElement>
  <RulesElement name="save ends" type="Effect Duration" internal-id="ID_OCC_DURATION_SAVE_ENDS" source="Open Compendium Core">
  </RulesElement>
  <RulesElement name="end of your next turn" type="Effect Duration" internal-id="ID_OCC_DURATION_END_OF_YOUR_NEXT_TURN" source="Open Compendium Core">
  </RulesElement>
  <RulesElement name="start of your next turn" type="Effect Duration" internal-id="ID_OCC_DURATION_START_OF_YOUR_NEXT_TURN" source="Open Compendium Core">
  </RulesElement>
  <RulesElement name="end of the encounter" type="Effect Duration" internal-id="ID_OCC_DURATION_END_OF_THE_ENCOUNTER" source="Open Compendium Core">
  </RulesElement>
  <RulesElement name="until removed" type="Effect Duration" internal-id="ID_OCC_DURATION_UNTIL_REMOVED" source="Open Compendium Core">
  </RulesElement>
  <!-- Optional Details (the original builder's campaign options, plus two house rules) -->
  <RulesElement name="Inherent Bonuses" type="Optional Detail" internal-id="ID_OCC_DETAIL_INHERENT" source="Open Compendium Core">
    <specific name="Key">inherent</specific>
    <specific name="IDs">ID_INTERNAL_INTERNAL_INHERENT_BONUSES</specific>
    Your character gets inherent enhancement bonuses to attacks, damage and defenses as you level, instead of relying on magic items.
  </RulesElement>
  <RulesElement name="Expertise and Defenses for free" type="Optional Detail" internal-id="ID_OCC_DETAIL_FEATTAX" source="Open Compendium Core">
    <specific name="Key">featTax</specific>
    <specific name="IDs">ID_FMP_FEAT_2785, ID_FMP_FEAT_3143</specific>
    The common fix for the later 4e math: every character gets Versatile Expertise and Improved Defenses without spending feats on them (+1 to attacks and to Fortitude, Reflex and Will, rising to +2 at 11th and +3 at 21st level).
  </RulesElement>
  <RulesElement name="Dark Sun" type="Optional Detail" internal-id="ID_OCC_DETAIL_DARKSUN" source="Open Compendium Core">
    <specific name="Key">darksun</specific>
    <specific name="IDs">ID_INTERNAL_INTERNAL_DARK_SUN</specific>
    A Dark Sun campaign on the continent of Athas. Adds a wild talent choice.
  </RulesElement>
  <RulesElement name="Spellscarred" type="Optional Detail" internal-id="ID_OCC_DETAIL_SPELLSCAR" source="Open Compendium Core">
    <specific name="Key">spellscar</specific>
    <specific name="IDs">ID_FMP_PSEUDO_CLASS_216</specific>
    Forgotten Realms characters can optionally start with a spellscar.
  </RulesElement>
  <RulesElement name="Harper" type="Optional Detail" internal-id="ID_OCC_DETAIL_HARPER" source="Open Compendium Core">
    <specific name="Key">harper</specific>
    <specific name="IDs">ID_INTERNAL_INTERNAL_HARPER</specific>
    Forgotten Realms characters who gain membership in the Harpers.
  </RulesElement>
  <RulesElement name="House Vadalis" type="Optional Detail" internal-id="ID_OCC_DETAIL_VADALIS" source="Open Compendium Core">
    <specific name="Key">vadalis</specific>
    <specific name="IDs">ID_INTERNAL_INTERNAL_HOUSE_VADALIS</specific>
    Eberron characters who are members of House Vadalis.
  </RulesElement>
  <RulesElement name="Circle of Smoke and Whispers" type="Optional Detail" internal-id="ID_OCC_DETAIL_SMOKE" source="Open Compendium Core">
    <specific name="Key">smoke</specific>
    <specific name="IDs">ID_INTERNAL_INTERNAL_CIRCLE_OF_SMOKE_AND_WHISPERS</specific>
    Membership in the Circle of Smoke and Whispers.
  </RulesElement>
  <RulesElement name="Intimidate with your best ability (house rule)" type="Optional Detail" internal-id="ID_OCC_DETAIL_INTIMHIGHEST" source="Open Compendium Core">
    <specific name="Key">intimHighest</specific>
    <specific name="Homebrew">Yes</specific>
    Intimidate uses your highest ability modifier instead of Charisma.
  </RulesElement>
  <RulesElement name="Free-acting companions (house rule)" type="Optional Detail" internal-id="ID_OCC_DETAIL_FREEBEASTS" source="Open Compendium Core">
    <specific name="Key">freeBeasts</specific>
    <specific name="Homebrew">Yes</specific>
    Your companions' basic attacks don't use your actions, and attack powers with the Beast keyword can be used by any of your beast companions.
  </RulesElement>
